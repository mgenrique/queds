{
  "name": "Queds Devcontainer",
  "dockerComposeFile": ["../docker-compose.yml"],
  "service": "devcontainer",
  "workspaceFolder": "/workspaces/queds",
  "shutdownAction": "stopCompose",
  "forwardPorts": [5173, 8000, 5000, 15432],
  "postStartCommand": "pip install -r /workspaces/queds/app/requirements.txt || true && cd /workspaces/queds/frontend && npm install || true",
  "extensions": [
    "ms-python.python",
    "ms-vscode.vscode-node-azure-pack"
  ],
  "settings": {
    "terminal.integrated.shell.linux": "/bin/bash"
  }
}
